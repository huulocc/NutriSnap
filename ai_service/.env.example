APP_NAME=NutriSnap AI Service
APP_ENV=production
API_PREFIX=/api/v1

MODEL_PATH=/data/quyhv/data/NutriSnap/ai_training/outputs/runs/20260717_162321_mobilenetv2_continuation/checkpoints/best_continued.keras
LABELS_PATH=/data/quyhv/data/NutriSnap/ai_training/metadata/food_labels.txt
CLASS_NAMES_PATH=/data/quyhv/data/NutriSnap/ai_training/metadata/class_names.json

MODEL_VERSION=mobilenetv2-v1
CONFIDENCE_THRESHOLD=0.50
DEFAULT_TOP_K=3
MAX_TOP_K=15

MAX_IMAGE_SIZE_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MAX_IMAGE_WIDTH=6000
MAX_IMAGE_HEIGHT=6000

INFERENCE_CONCURRENCY=1
AUTH_MODE=api_key
API_KEY=replace-with-secret
ENABLE_DOCS=true
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
WORKERS=1
